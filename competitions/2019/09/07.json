ilto:csinclair@worldcubeassociation.org}]","email":null}],"organisers":[{"name":"[{Chris Tabar}{mailto:ctabar@worldcubeassociation.org}]","email":null}],"venue":{"name":"[Corbin Senior Center](https://corbinseniorcenter.org/)","address":"Corbin Senior Activity Center, 827 West Cleveland Avenue, Spokane, WA","details":"Henderson Ballroom (2nd Floor)","coordinates":{"latitude":47.683624,"longitude":-117.424826}},"information":null,"externalWebsite":"NULL"},{"id":"SwissScienceOpen2019","name":"Swiss Science Open 2019","city":"Winterthur","country":"CH","date":{"from":"2019-09-07","till":"2019-09-08","numberOfDays":2},"isCanceled":false,"events":["333","222","444","555","333bf","333oh","minx","pyram","skewb","sq1"],"wcaDelegates":[{"name":"[{Tobias Peter}{mailto:tobias.peter@bluewin.ch}]","email":null}],"organisers":[{"name":"[{Thomas Stadler}{mailto:thomasstadler@thurweb.ch}]","email":null}],"venue":{"name":"[Swiss Science Center](http://www.technorama.ch/)","address":"Technoramastrasse 1, 8404 Winterthur","details":"Technorama Winterthur, Foyer im 2.Stock (2nd floor)","coordinates":{"latitude":47.514069,"longitude":8.764489}},"information":"[DE] Die Swiss Science Open 2019 im Technorama werden nicht nur für Teilnehmer sondern auch für alle registrierten Gäste ein Erlebnis werden. Alle Teilnehmer und registrierten Gäste erhalten für 15CHF für Sa+So freien Eintritt ins Technorama. Dort erwarten euch neben der Speedcubing Competition im Foyer ganz viele Versuche aus der Welt der Physik, welche ihr ausprobieren könnt. Registriert euch und alle eure Begleitpersonen (Gäste) um für 2 Tage den freien Eintritt ins Technorama zu bekommen. [EN] The Swiss Science Open 2019 in the Technorama will be an experience not only for participants but also for all registered guests. All participants and registered guests receive for 15CHF for Sa + Sun free admission to the Technorama. In addition to the Speedcubing Competition in the foyer, you can expect many experiments from the world of physics, which you can try out. Register yourself and all your escorts (guests) to get free admission to the Technorama for 2 days.","externalWebsite":"https://cubecomp.de/sso19/de"},{"id":"TimisoaraWestSideOpen2019","name":"Timisoara West Side Open 2019","city":"Timisoara","country":"RO","date":{"from":"2019-09-07","till":"2019-09-07","numberOfDays":1},"isCanceled":false,"events":["333","222","444","333bf","333oh","pyram"],"wcaDelegates":[{"name":"[{Mihai Căpăţinescu}{mailto:mcapatinescu@worldcubeassociation.org}]","email":null}],"organisers":[{"name":"[{Bianca-Maria Morgociu}{mailto:bianca.niall93@gmail.com}] [{Ilie-Laurenţiu Soare}{mailto:soareilielaurentiu@gmail.com}] [{Mihai Căpăţinescu}{mailto:mcapatinescu@worldcubeassociation.org}]","email":null}],"venue":{"name":"[Universitatea de Vest din Timisoara](https://www.uvt.ro/ro/)","address":"Bulevardul Vasile Pârvan 4, Timișoara 300223","details":"Main hall from the 1st floor","coordinates":{"latitude":45.747057,"longitude":21.230832}},"information":"At the registration you can support the association \"Asociatia Romana de Speedcubing\" with a contribution and you will get a cubing prize. Prizes Certificates and medals for top 3 newcomers. Certificates and medals for the fastest girl, youngest competitor, oldest competitor and fastest competitor. Certificates and medals for top 3 of each event.","externalWebsite":"NULL"},{"id":"XelaOpen2019","name":"Xela Open 2019","city":"Quetzaltenango","country":"GT","date":{"from":"2019-09-07","till":"2019-09-08","numberOfDays":2},"isCanceled":false,"events":["333","222","444","555","666","777","333bf","333oh","clock","minx","pyram","skewb","sq1"],"wcaDelegates":[{"name":"[{Luis David Hernández Mejía}{mailto:lmejia@worldcubeassociation.org}]","email":null}],"organisers":[{"name":"[{Jackie Vásquez}{mailto:kakaw08@hotmail.com}] [{Pablo Say}{mailto:rubiksxela@gmail.com}]","email":null}],"venue":{"name":"Centro Cultural Casa NOJ","address":"7ma calle 12-12 zona 1, Quetzaltenango","details":"Salón Principal","coordinates":{"latitude":14.83372,"longitude":-91.518972}},"information":"Competencia que se desarrolla por quinta vez en Quetzaltenango. Con el objetivo principal de aumentar la comunidad en esta area del pais y asi promover mas el speedcubing. Competition that takes place for the fifth time in Quetzaltenango. With the main objective of increasing the community in this area of the country and thus promote more speedcubing. English \"Competing T-shirts for those who register on the same day will be given until stocks run out. \" Español \"Las camisetas que compiten para aquellos que se registren el mismo día se darán hasta que las existencias se agoten\" ","externalWebsite":"NULL"}]}